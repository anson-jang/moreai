@model IEnumerable<moreai.web.Models.Group>

@{
    ViewData["Title"] = "群組管理";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">建立新群組</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                群組名稱
            </th>
            <th>
                描述
            </th>
            <th>
                成員數
            </th>
            <th>
                建立時間
            </th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @(item.Members?.Count ?? 0)
            </td>
            <td>
                @item.CreatedAt.ToString("yyyy/MM/dd HH:mm:ss")
            </td>
            <td>
                <a asp-action="Members" asp-route-id="@item.Id" class="btn btn-info btn-sm">成員管理</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">編輯</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">刪除</a>
            </td>
        </tr>
}
    </tbody>
</table>