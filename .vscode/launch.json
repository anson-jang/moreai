{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (https)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/smartadmin/bin/Debug/net9.0/Smartadmin.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/smartadmin",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7006"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      },
      "launchBrowser": {
        "enabled": true,
        "args": "${auto-detect-url}",
        "osx": {
          "command": "open"
        }
      }
    }
  ]
} 