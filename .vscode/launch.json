{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (https)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/moreai.web/bin/Debug/net9.0/moreai.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/moreai.web",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "launchBrowser": {
        "enabled": true,
        "args": "https://localhost:7224",
        "windows": {
          "command": "cmd.exe",
          "args": "/C start ${auto-detect-url}"
        }
      }
    }
  ]
}